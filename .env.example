# Use a fresh Supabase project dedicated to this test.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# PRIVATE: set only on the server (never NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-server-side-secret-key
# Must match the email of the Supabase Auth user you create for yourself.
ADMIN_EMAIL=your-email@example.com
